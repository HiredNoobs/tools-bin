# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------

# -----------------------------------------------------
# Prompt
# -----------------------------------------------------

function color_environment {
  local color
  case "$1" in
    *production*) color='\[\e[31m\]';;
    *test*)       color='\[\e[33m\]';;
    *)            color='\[\e[32m\]';;
  esac

  printf '%s%s\[\e[0m\]' "$color" "$1"
}

function parse_git_branch {
  local ref
  ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) || return
  printf "(%s)" "${ref##refs/heads/}"
}

function parse_venv {
  if [[ -n "$VIRTUAL_ENV" ]]; then
    printf "(%s)" "$(basename "$VIRTUAL_ENV")"
  fi
}

function prompt_setter {
  local context venv git_branch
  context="$(color_environment "$(current_context)")"
  venv="$(parse_venv)"
  git_branch="$(parse_git_branch)"

  [ -n "$venv" ] && venv="$venv " 
  [ -n "$git_branch" ] && git_branch=" $git_branch" 

  if [ -n "$DEPLOYMENT" ]; then
    PS1=$'\u256d\u2524'"$context $(color_environment $ENVIRONMENT)/\[\e[36m\]${STACK}\[\e[0m\]"$'\u2502'"\n"$'\u2570\u2574'"${venv}"'\W'"${git_branch}"' \$ '
  else
    PS1=$"[$context ${venv}\W${git_branch}] \$ "
  fi
}

PROMPT_COMMAND=prompt_setter

# -----------------------------------------------------
# Extra commands
# -----------------------------------------------------

# Contexts depend on the host's ORCHESTRATOR (see context-setup),
# k8s contexts are kubeconfig/talosconfig files selected with KUBECONFIG/TALOSCONFIG.
function current_context {
  case "$ORCHESTRATOR" in
    k8s) [[ -n "$KUBECONFIG" ]] && basename "$KUBECONFIG" .yaml;;
    *)   echo "${DOCKER_CONTEXT:-default}";;
  esac
}

function list_contexts {
  local config
  case "$ORCHESTRATOR" in
    k8s)
      for config in "$KUBE_CONTEXTS"/*.yaml; do
        [[ -f "$config" ]] && basename "$config" .yaml
      done
      ;;
    *) docker context ls --format '{{ .Name }}';;
  esac
}

# `dc` command for viewing and switching docker/kube context
function dc {
  local contexts
  contexts=$(list_contexts)
  if [[ -z "$1" ]]; then
    echo "Current context: $(current_context)"
    echo
    echo "$contexts"
  else
    if echo "$contexts" | grep -q "^$1$"; then
      case "$ORCHESTRATOR" in
        k8s)
          export KUBECONFIG="$KUBE_CONTEXTS/$1.yaml"
          export TALOSCONFIG="$TALOS_CONTEXTS/$1.yaml"
          ;;
        *)   export DOCKER_CONTEXT="$1";;
      esac
    else
      echo "Context $1 does not exist in this environment."
    fi
  fi
}

_dc_completions() {
  if [[ "${#COMP_WORDS[@]}" != "2" ]]; then
    return
  fi

  COMPREPLY=($(compgen -W "$(list_contexts)" -- "${COMP_WORDS[1]}"))
}

complete -F _dc_completions dc

# -----------------------------------------------------
# Allow `deployment` to complete available commands
# and where command is `tools` it will suggest tools.

_deployment_completions() {
  local cur prev file_list script_commands
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  if [[ $prev == "tools" ]]; then
    if [[ -d "$PWD/tools" ]]; then
      file_list=$(find $PWD/tools -maxdepth 1 -type f -executable -executable -exec basename {} \;)
      COMPREPLY=($(compgen -W "$file_list" -- "$cur"))
    else
      COMPREPLY=()
    fi
  else
    script_commands=$(deployment help 2>/dev/null | grep '^* ' | sed 's/^* //' | tr '\n' ' ')
    COMPREPLY=($(compgen -W "$script_commands" -- "$cur"))
  fi
}

complete -F _deployment_completions deployment
