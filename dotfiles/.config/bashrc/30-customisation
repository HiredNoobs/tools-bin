# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------

# -----------------------------------------------------
# Prompt
# -----------------------------------------------------

# Starship (~/.config/starship.toml, shared with fish). Without it, a plain version of the
# same two lines: the context and git branch, then the venv, the directory and \$.
if command -v starship > /dev/null; then
  eval "$(starship init bash)"
else
  function parse_git_branch {
    local ref
    ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) || return
    printf "[%s]" "${ref##refs/heads/}"
  }

  function parse_venv {
    [[ -n "${VIRTUAL_ENV:-}" ]] && printf '(%s) ' "$(basename "$VIRTUAL_ENV")"
  }

  function color_context {
    local color
    case "$1" in
      *production*) color='\[\e[1;31m\]';;
      *test*)       color='\[\e[33m\]';;
      *)            color='\[\e[32m\]';;
    esac
    [[ -n "$1" ]] && printf '[%s%s\[\e[0m\]]' "$color" "$1"
  }

  function prompt_setter {
    PS1=$'\n╭─'"$(color_context "$(current_context)")$(parse_git_branch)"$'\n╰─ '"$(parse_venv)\[\e[1;34m\]\W\[\e[0m\] \\$ "
  }

  PROMPT_COMMAND=prompt_setter
fi

# -----------------------------------------------------
# Contexts
# -----------------------------------------------------

# k8s contexts are one kubeconfig/talosconfig per cluster (see context-setup), selected
# per shell with KUBECONFIG/TALOSCONFIG.
function current_context {
  [[ -n "${KUBECONFIG:-}" ]] && basename "$KUBECONFIG" .yaml
}

function list_contexts {
  local config
  for config in "${KUBE_CONTEXTS:-$HOME/.kube/contexts}"/*.yaml; do
    [[ -f "$config" ]] && basename "$config" .yaml
  done
}

# `kc` shows or switches the kube (and Talos) context for this shell.
function kc {
  local contexts
  contexts=$(list_contexts)
  if [[ -z "${1:-}" ]]; then
    echo "Current context: $(current_context)"
    echo
    echo "$contexts"
  elif grep -qx -- "$1" <<< "$contexts"; then
    export KUBECONFIG="${KUBE_CONTEXTS:-$HOME/.kube/contexts}/$1.yaml"
    export TALOSCONFIG="${TALOS_CONTEXTS:-$HOME/.talos/contexts}/$1.yaml"
  else
    echo "Context $1 does not exist on this host."
    return 1
  fi
}

_kc_completions() {
  if [[ "${#COMP_WORDS[@]}" != "2" ]]; then
    return
  fi

  COMPREPLY=($(compgen -W "$(list_contexts)" -- "${COMP_WORDS[1]}"))
}

complete -F _kc_completions kc

# `kns` (tools-bin) completes the current context's namespaces.
_kns_completions() {
  if [[ "${#COMP_WORDS[@]}" != "2" ]]; then
    return
  fi

  COMPREPLY=($(compgen -W "$(kubectl get namespaces -o name 2> /dev/null | sed 's|^namespace/||')" -- "${COMP_WORDS[1]}"))
}

complete -F _kns_completions kns
