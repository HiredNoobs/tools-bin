#!/bin/sh
# Keeps the current Wi-Fi network's name in /run/quickshell-lock/ssid for the SDDM theme, which
# runs before login and can't ask NetworkManager (or read its connections) itself.

case "$2" in
  up | down | connectivity-change) ;;
  *) exit 0 ;;
esac

mkdir -p /run/quickshell-lock
nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -n 1 > /run/quickshell-lock/ssid.new
chmod 644 /run/quickshell-lock/ssid.new
mv /run/quickshell-lock/ssid.new /run/quickshell-lock/ssid
