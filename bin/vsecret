#!/usr/bin/env bash
#
# Usage: vsecret <command> [args]
#
#   ls [path]                            List secrets (default: production/).
#   get <path> [--show]                  The keys and their lengths (--show: the values too).
#   get <path> <KEY>                     One value, raw (for scripts and pipes).
#   set <path> KEY[=VALUE|=@FILE] ...    Set keys, creating the secret if it's new. A KEY with
#       [--generate N]                   no value is prompted for (not echoed), or with
#                                        --generate gets N random letters and digits.
#   unset <path> KEY ...                 Remove keys.
#   edit <path>                          Edit all keys as JSON in $EDITOR, confirm, write.
#
# A <path> without a "/" is in production/ (redis -> production/redis). Writes merge into the
# existing secret and are check-and-set (labv2 requires it): they only land if nobody changed
# the secret since it was read. After a write, the ExternalSecrets reading that path are
# force-synced so the change reaches the cluster now (--no-sync to skip).
#
# The secret's changes are worked out by secret-merge and secret-compare (JSON in, JSON out),
# this does the Vault and cluster side. Values travel in pipes, not arguments or files.

THIS=$(realpath "$0")
HERE=$(dirname "$THIS")

source "$HERE/lib/logging.sh"

set -euo pipefail

MOUNT="labv2"

# -----------------------------------------------------
# Parsing args
# -----------------------------------------------------

SHOW=false
SYNC=true
GENERATE=()
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --show) SHOW=true; shift;;
    --no-sync) SYNC=false; shift;;
    --generate|-g) GENERATE=(--generate "$2"); shift 2;;
    -h|--help) sed -n '2,/^$/p' "$THIS" | sed 's/^# \{0,1\}//'; exit 0;;
    --) shift; while [[ $# -gt 0 ]]; do POSITIONAL_ARGS+=("$1"); shift; done;;
    -*) log_error "Unknown option: $1"; exit 1;;
    *) POSITIONAL_ARGS+=("$1"); shift;;
  esac
done

set -- "${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}"
COMMAND="${1:-}"
shift || true

# -----------------------------------------------------
# Functions
# -----------------------------------------------------

function full_path {
  if [[ "$1" == */* ]]; then
    echo "${1%/}"
  else
    echo "production/$1"
  fi
}

# Sets VERSION and DATA (a JSON object) for the secret at $1, 0 and {} if it doesn't exist.
function read_secret {
  local out err

  if out=$(vault kv get -format=json -mount="$MOUNT" "$1" 2> /dev/null); then
    VERSION=$(jq -r '.data.metadata.version' <<< "$out")
    DATA=$(jq -c '.data.data // {}' <<< "$out")
    return 0
  fi

  # Not there, or an error: the reason is on stderr (captured first, vault's exit code would
  # fail a pipe into grep under pipefail).
  err=$(vault kv get -mount="$MOUNT" "$1" 2>&1 > /dev/null) || true
  if grep -q "No value found" <<< "$err"; then
    VERSION=0
    DATA="{}"
  else
    echo "$err" >&2
    log_error "Couldn't read $MOUNT/$1."
    exit 1
  fi
}

# Force-syncs the ExternalSecrets whose data comes from $1, in every namespace.
function sync_external_secrets {
  local path="$1" es ns name

  if ! command -v kubectl > /dev/null || ! kubectl get --raw /readyz --request-timeout=5s > /dev/null 2>&1; then
    log_warning "No cluster reachable, ExternalSecrets pick the change up at their next refresh (up to 1h)."
    return 0
  fi

  es=$(kubectl get externalsecrets --all-namespaces -o json | jq -r --arg p "$path" '
    .items[]
    | select(([.spec.dataFrom[]?.extract.key, .spec.data[]?.remoteRef.key] | index($p)) != null)
    | "\(.metadata.namespace) \(.metadata.name)"')

  if [[ -z "$es" ]]; then
    log_info "No ExternalSecret reads $path."
    return 0
  fi

  while read -r ns name; do
    kubectl annotate externalsecret "$name" --namespace "$ns" force-sync="$(date +%s)" --overwrite > /dev/null
    log_info "Force-synced ExternalSecret $ns/$name."
  done <<< "$es"
}

# Writes $4 (the new secret) over $3 (what was read, at version $2) to path $1: shows what
# changed, optionally asks first ($5 = confirm), then a check-and-set write and the sync.
function apply_secret {
  local path="$1" version="$2" old="$3" new="$4" confirm="${5:-}" summary status answer out

  summary=$("$HERE/secret-compare" <(printf '%s' "$old") <(printf '%s' "$new")) && status=0 || status=$?
  case "$status" in
    0) log_info "No changes to $MOUNT/$path."; return 0;;
    1) ;;
    *) log_error "Nothing written."; exit 1;;
  esac

  if [[ "$(jq 'length' <<< "$new")" == "0" ]]; then
    log_error "That would leave $MOUNT/$path empty. To delete a secret: vault kv metadata delete -mount=$MOUNT $path"
    exit 1
  fi

  echo "$summary" >&2
  if [[ -n "$confirm" ]]; then
    read -r -p "Write to $MOUNT/$path? [y/N] " answer
    if [[ "$answer" != [yY]* ]]; then
      log_info "Nothing written."
      return 0
    fi
  fi

  if ! out=$(printf '%s' "$new" | vault kv put -format=json -cas="$version" -mount="$MOUNT" "$path" - 2>&1); then
    if grep -q "check-and-set" <<< "$out"; then
      log_error "$MOUNT/$path changed since it was read. Nothing written, run it again."
    else
      echo "$out" >&2
      log_error "Couldn't write $MOUNT/$path."
    fi
    exit 1
  fi
  log_info "Wrote $MOUNT/$path (version $(jq -r '.data.version // "?"' <<< "$out"))."

  if [[ "$SYNC" == true ]]; then
    sync_external_secrets "$path"
  fi
}

# -----------------------------------------------------
# Commands
# -----------------------------------------------------

function command_ls {
  vault kv list -mount="$MOUNT" "${1:-production}"
}

function command_get {
  local path
  path=$(full_path "${1:?Usage: vsecret get <path> [KEY] [--show]}")
  read_secret "$path"

  if [[ "$VERSION" == "0" ]]; then
    log_error "$MOUNT/$path doesn't exist."
    exit 1
  fi

  if [[ -n "${2:-}" ]]; then
    if ! jq -e --arg k "$2" 'has($k)' <<< "$DATA" > /dev/null; then
      log_error "$MOUNT/$path has no key $2."
      exit 1
    fi
    jq -r --arg k "$2" '.[$k]' <<< "$DATA"
  elif [[ "$SHOW" == true ]]; then
    jq -S . <<< "$DATA"
  else
    log_info "$MOUNT/$path, version $VERSION (values hidden, --show to see them):"
    jq -r 'to_entries | sort_by(.key)[] | "  \(.key) (\(.value | length) chars)"' <<< "$DATA"
  fi
}

function command_set {
  local path new
  path=$(full_path "${1:?Usage: vsecret set <path> KEY[=VALUE|=@FILE] ... [--generate N]}")
  shift
  if [[ $# -eq 0 ]]; then
    log_error "No keys given. Usage: vsecret set <path> KEY[=VALUE|=@FILE] ... [--generate N]"
    exit 1
  fi

  read_secret "$path"
  new="$DATA"

  # A KEY without a value (and no --generate) is prompted for, not echoed. Each goes to
  # secret-merge as KEY=@<pipe>, so the value is never an argument or on disk: one call per
  # key, as a process substitution only lasts for the command it's in.
  local arg value given=()
  for arg in "$@"; do
    if [[ "$arg" == *=* || ${#GENERATE[@]} -gt 0 ]]; then
      given+=("$arg")
      continue
    fi
    value=""
    read -r -s -p "$arg: " value || true
    echo >&2
    if [[ -z "$value" ]]; then
      log_error "Empty value for $arg, nothing written."
      exit 1
    fi
    new=$(printf '%s' "$new" | "$HERE/secret-merge" "$arg=@"<(printf '%s' "$value"))
  done

  if [[ ${#given[@]} -gt 0 ]]; then
    new=$(printf '%s' "$new" | "$HERE/secret-merge" "${GENERATE[@]+"${GENERATE[@]}"}" "${given[@]}")
  fi

  apply_secret "$path" "$VERSION" "$DATA" "$new"
}

function command_unset {
  local path key new args=()
  path=$(full_path "${1:?Usage: vsecret unset <path> KEY ...}")
  shift
  if [[ $# -eq 0 ]]; then
    log_error "No keys given. Usage: vsecret unset <path> KEY ..."
    exit 1
  fi

  for key in "$@"; do
    args+=(--unset "$key")
  done

  read_secret "$path"
  new=$(printf '%s' "$DATA" | "$HERE/secret-merge" "${args[@]}")
  apply_secret "$path" "$VERSION" "$DATA" "$new"
}

function command_edit {
  local path new
  path=$(full_path "${1:?Usage: vsecret edit <path>}")
  read_secret "$path"

  # The one file holding values: private, in memory where possible, removed on exit.
  EDIT_FILE=$(mktemp -p /dev/shm 2> /dev/null || mktemp)
  chmod 600 "$EDIT_FILE"
  trap 'rm -f "$EDIT_FILE"' EXIT

  jq -S . <<< "$DATA" > "$EDIT_FILE"
  ${EDITOR:-vi} "$EDIT_FILE"
  new=$(cat "$EDIT_FILE")

  apply_secret "$path" "$VERSION" "$DATA" "$new" confirm
}

# -----------------------------------------------------
# Main
# -----------------------------------------------------

for cmd in vault jq python3; do
  if ! command -v "$cmd" > /dev/null; then
    log_error "'$cmd' isn't installed."
    exit 1
  fi
done

case "$COMMAND" in
  ls) command_ls "$@";;
  get) command_get "$@";;
  set) command_set "$@";;
  unset) command_unset "$@";;
  edit) command_edit "$@";;
  ""|help) sed -n '2,/^$/p' "$THIS" | sed 's/^# \{0,1\}//';;
  *) log_error "Unknown command: $COMMAND (vsecret help)"; exit 1;;
esac
