#!/usr/bin/env bash
#
# Usage: vsecret <command> [args]
#
#   ls [path]                            List secrets (default: production/).
#   get <path> [--show]                  The keys and their lengths (--show: the values too).
#   get <path> <KEY>                     One value, raw (for scripts and pipes).
#   set <path> KEY[=VALUE|=@FILE] ...    Set keys, creating the secret if it's new. A KEY with
#       [--generate N]                   no value is prompted for (not echoed), or with
#                                        --generate gets N random letters and digits.
#   unset <path> KEY ...                 Remove keys.
#   edit <path>                          Edit all keys as JSON in $EDITOR, confirm, write.
#   files pull|push|diff <path> <dir>    File-shaped secrets, one file per key (e.g. a CA's
#                                        ca.crt and ca.key). pull keeps the version for push.
#
# A <path> without a "/" is in production/ (redis -> production/redis). After a write, the
# ExternalSecrets reading that path are force-synced so the change reaches the cluster now
# rather than at their next refresh (--no-sync to skip).

THIS=$(realpath "$0")
HERE=$(dirname "$THIS")

source "$HERE/lib/logging.sh"

# Stop at the first failure: nothing half-built may reach Vault.
set -euo pipefail

MOUNT="labv2"

# -----------------------------------------------------
# Parsing args
# -----------------------------------------------------

SHOW=false
SYNC=true
GENERATE=""
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --show) SHOW=true; shift;;
    --no-sync) SYNC=false; shift;;
    --generate|-g) GENERATE="$2"; shift 2;;
    -h|--help) sed -n '2,/^$/p' "$THIS" | sed 's/^# \{0,1\}//'; exit 0;;
    --) shift; while [[ $# -gt 0 ]]; do POSITIONAL_ARGS+=("$1"); shift; done;;
    -*) log_error "Unknown option: $1"; exit 1;;
    *) POSITIONAL_ARGS+=("$1"); shift;;
  esac
done

set -- "${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}"
COMMAND="${1:-}"
shift || true

if [[ -n "$GENERATE" && ! "$GENERATE" =~ ^[0-9]+$ ]]; then
  log_error "--generate takes a length, e.g. --generate 32"
  exit 1
fi

# -----------------------------------------------------
# Functions
# -----------------------------------------------------

function require {
  local cmd
  for cmd in "$@"; do
    if ! command -v "$cmd" > /dev/null; then
      log_error "'$cmd' isn't installed."
      exit 1
    fi
  done
}

function full_path {
  if [[ "$1" == */* ]]; then
    echo "${1%/}"
  else
    echo "production/$1"
  fi
}

# The secret as {"version": N, "data": {...}} on stdout, version 0 and no data if it doesn't
# exist (or its latest version is deleted). Exits on any other error.
function read_secret {
  local path="$1" out err

  err=$(mktemp)
  if out=$(vault kv get -format=json -mount="$MOUNT" "$path" 2> "$err"); then
    rm -f "$err"
    jq '{version: .data.metadata.version, data: (.data.data // {})}' <<< "$out"
  elif grep -q "No value found" "$err"; then
    rm -f "$err"
    echo '{"version": 0, "data": {}}'
  else
    cat "$err" >&2
    rm -f "$err"
    log_error "Couldn't read $MOUNT/$path."
    exit 1
  fi
}

# Writes the JSON object on stdin as the whole secret, only if its version is still $2
# (0: only if it doesn't exist yet).
function write_secret {
  local path="$1" cas="$2" out

  if out=$(vault kv put -format=json -cas="$cas" -mount="$MOUNT" "$path" - 2>&1); then
    log_info "Wrote $MOUNT/$path (version $(jq -r '.data.version // .version // "?"' <<< "$out" 2> /dev/null))."
  elif grep -q "check-and-set" <<< "$out"; then
    log_error "$MOUNT/$path changed since it was read (another write in between). Nothing written, run it again."
    exit 1
  else
    echo "$out" >&2
    log_error "Couldn't write $MOUNT/$path."
    exit 1
  fi
}

# True if two JSON files hold the same object.
function same_json {
  jq -e -n --slurpfile a "$1" --slurpfile b "$2" '$a[0] == $b[0]' > /dev/null
}

# Prints which keys were added, changed and removed between two JSON objects (files).
function summarise {
  jq -r -n --slurpfile old "$1" --slurpfile new "$2" '
    ($old[0]) as $o | ($new[0]) as $n
    | ([$n | keys[] | select($o[.] == null)] | map("  added:   " + .)[]),
      ([$n | keys[] | select($o[.] != null and $o[.] != $n[.])] | map("  changed: " + .)[]),
      ([$o | keys[] | select($n[.] == null)] | map("  removed: " + .)[])'
}

# Force-syncs the ExternalSecrets whose data comes from $1, in every namespace.
function sync_external_secrets {
  local path="$1" es

  [[ "$SYNC" == true ]] || return 0

  if ! command -v kubectl > /dev/null || ! kubectl get --raw /readyz --request-timeout=5s > /dev/null 2>&1; then
    log_warning "No cluster reachable, ExternalSecrets pick the change up at their next refresh."
    return 0
  fi

  es=$(kubectl get externalsecrets --all-namespaces -o json | jq -r --arg p "$path" '
    .items[]
    | select(([.spec.dataFrom[]?.extract.key, .spec.data[]?.remoteRef.key] | index($p)) != null)
    | "\(.metadata.namespace) \(.metadata.name)"')

  if [[ -z "$es" ]]; then
    log_info "No ExternalSecret reads $path."
    return 0
  fi

  local ns name
  while read -r ns name; do
    kubectl annotate externalsecret "$name" --namespace "$ns" force-sync="$(date +%s)" --overwrite > /dev/null \
      && log_info "Force-synced ExternalSecret $ns/$name."
  done <<< "$es"
}

# A private scratch directory for the decrypted values ($SCRATCH), in memory where possible,
# removed on exit. Global, so the exit trap still sees it after the function returns.
function make_scratch {
  SCRATCH=""
  if [[ -d /dev/shm ]]; then
    SCRATCH=$(mktemp -d -p /dev/shm 2> /dev/null) || SCRATCH=""
  fi
  if [[ -z "$SCRATCH" ]]; then
    SCRATCH=$(mktemp -d 2> /dev/null) || SCRATCH=""
  fi
  if [[ -z "$SCRATCH" || ! -d "$SCRATCH" ]]; then
    log_error "Couldn't create a scratch directory."
    exit 1
  fi
  chmod 700 "$SCRATCH"
  trap 'rm -rf "$SCRATCH"' EXIT
}

# -----------------------------------------------------
# Commands
# -----------------------------------------------------

function command_ls {
  vault kv list -mount="$MOUNT" "${1:-production}"
}

function command_get {
  local path secret
  path=$(full_path "${1:?Usage: vsecret get <path> [KEY] [--show]}")
  secret=$(read_secret "$path") || exit 1

  if [[ "$(jq -r '.version' <<< "$secret")" == "0" ]]; then
    log_error "$MOUNT/$path doesn't exist."
    exit 1
  fi

  if [[ -n "${2:-}" ]]; then
    if ! jq -e --arg k "$2" '.data | has($k)' <<< "$secret" > /dev/null; then
      log_error "$MOUNT/$path has no key $2."
      exit 1
    fi
    jq -r --arg k "$2" '.data[$k]' <<< "$secret"
  elif [[ "$SHOW" == true ]]; then
    jq '.data' <<< "$secret"
  else
    log_info "$MOUNT/$path, version $(jq -r '.version' <<< "$secret") (values hidden, --show to see them):"
    jq -r '.data | to_entries[] | "  \(.key) (\(.value | length) chars)"' <<< "$secret"
  fi
}

function command_set {
  local path secret dir arg key value
  path=$(full_path "${1:?Usage: vsecret set <path> KEY[=VALUE|=@FILE] ... [--generate N]}")
  shift

  if [[ $# -eq 0 ]]; then
    log_error "No keys given. Usage: vsecret set <path> KEY[=VALUE|=@FILE] ... [--generate N]"
    exit 1
  fi

  secret=$(read_secret "$path") || exit 1
  make_scratch
  dir="$SCRATCH"

  jq '.data' <<< "$secret" > "$dir/old.json"
  cp "$dir/old.json" "$dir/new.json"

  for arg in "$@"; do
    key="${arg%%=*}"

    if [[ ! "$key" =~ ^[A-Za-z0-9_.-]+$ ]]; then
      log_error "'$key' isn't a key name (letters, digits, _ . -)."
      exit 1
    fi

    if [[ "$arg" == *=@* ]]; then
      value=$(cat "${arg#*=@}") || exit 1
    elif [[ "$arg" == *=* ]]; then
      value="${arg#*=}"
    elif [[ -n "$GENERATE" ]]; then
      # tr ends on a broken pipe when head has enough, so the length is checked instead.
      value=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom 2> /dev/null | head -c "$GENERATE" || true)
      if [[ ${#value} -ne $GENERATE ]]; then
        log_error "Couldn't generate a value for $key."
        exit 1
      fi
    else
      read -r -s -p "$key: " value
      echo >&2
      if [[ -z "$value" ]]; then
        log_error "Empty value for $key, nothing written."
        exit 1
      fi
    fi

    # The value goes to jq through a file, not its arguments.
    printf '%s' "$value" > "$dir/value"
    jq --arg k "$key" --rawfile v "$dir/value" '. + {($k): $v}' "$dir/new.json" > "$dir/tmp.json"
    mv "$dir/tmp.json" "$dir/new.json"
  done
  rm -f "$dir/value"

  if same_json "$dir/old.json" "$dir/new.json"; then
    log_info "No changes, $MOUNT/$path already has those values."
    return 0
  fi

  summarise "$dir/old.json" "$dir/new.json"
  write_secret "$path" "$(jq -r '.version' <<< "$secret")" < "$dir/new.json"
  sync_external_secrets "$path"
}

function command_unset {
  local path secret dir key
  path=$(full_path "${1:?Usage: vsecret unset <path> KEY ...}")
  shift

  if [[ $# -eq 0 ]]; then
    log_error "No keys given. Usage: vsecret unset <path> KEY ..."
    exit 1
  fi

  secret=$(read_secret "$path") || exit 1
  make_scratch
  dir="$SCRATCH"

  jq '.data' <<< "$secret" > "$dir/old.json"
  cp "$dir/old.json" "$dir/new.json"

  for key in "$@"; do
    if ! jq -e --arg k "$key" 'has($k)' "$dir/old.json" > /dev/null; then
      log_error "$MOUNT/$path has no key $key."
      exit 1
    fi
    jq --arg k "$key" 'del(.[$k])' "$dir/new.json" > "$dir/tmp.json"
    mv "$dir/tmp.json" "$dir/new.json"
  done

  if [[ "$(jq 'length' "$dir/new.json")" == "0" ]]; then
    log_error "That would leave $MOUNT/$path empty. To delete a secret: vault kv metadata delete -mount=$MOUNT $path"
    exit 1
  fi

  summarise "$dir/old.json" "$dir/new.json"
  write_secret "$path" "$(jq -r '.version' <<< "$secret")" < "$dir/new.json"
  sync_external_secrets "$path"
}

function command_edit {
  local path secret dir answer
  path=$(full_path "${1:?Usage: vsecret edit <path>}")

  secret=$(read_secret "$path") || exit 1
  make_scratch
  dir="$SCRATCH"

  jq -S '.data' <<< "$secret" > "$dir/old.json"
  cp "$dir/old.json" "$dir/secret.json"

  "${EDITOR:-vi}" "$dir/secret.json"

  if ! jq -e 'type == "object" and all(.[]; type == "string")' "$dir/secret.json" > /dev/null 2>&1; then
    log_error "Not a JSON object of string values, nothing written."
    exit 1
  fi

  if same_json "$dir/old.json" "$dir/secret.json"; then
    log_info "No changes."
    return 0
  fi

  if [[ "$(jq 'length' "$dir/secret.json")" == "0" ]]; then
    log_error "That would leave $MOUNT/$path empty, nothing written."
    exit 1
  fi

  summarise "$dir/old.json" "$dir/secret.json"
  read -r -p "Write to $MOUNT/$path? [y/N] " answer
  if [[ "$answer" != [yY]* ]]; then
    log_info "Nothing written."
    return 0
  fi

  write_secret "$path" "$(jq -r '.version' <<< "$secret")" < "$dir/secret.json"
  sync_external_secrets "$path"
}

function command_files {
  local action="${1:-}" path dir cas out
  path=$(full_path "${2:?Usage: vsecret files pull|push|diff <path> <dir>}")
  dir="${3:?Usage: vsecret files pull|push|diff <path> <dir>}"

  case "$action" in
    pull)
      mkdir -p "$dir"
      out=$(vault kv get -format=json -mount="$MOUNT" "$path") || exit 1
      jq '.data.data' <<< "$out" | "$HERE/secret-unpack" "$dir"
      jq '.data.metadata' <<< "$out" > "$dir/.metadata.json"
      log_info "Pulled $MOUNT/$path into $dir."
      ;;
    push)
      if ! compgen -G "$dir/*" > /dev/null; then
        log_error "No files in $dir. To delete a secret: vault kv metadata delete -mount=$MOUNT $path"
        exit 1
      fi
      if [[ -f "$dir/.metadata.json" ]]; then
        cas=$(jq -r '.version' "$dir/.metadata.json")
      else
        cas=0
      fi
      # Packed and checked before anything is written.
      make_scratch
      "$HERE/secret-pack" "$dir"/* > "$SCRATCH/packed.json"
      if ! jq -e 'type == "object" and length > 0' "$SCRATCH/packed.json" > /dev/null 2>&1; then
        log_error "Couldn't pack the files in $dir, nothing written."
        exit 1
      fi
      write_secret "$path" "$cas" < "$SCRATCH/packed.json"
      vault kv get -format=json -mount="$MOUNT" "$path" | jq '.data.metadata' > "$dir/.metadata.json"
      sync_external_secrets "$path"
      ;;
    diff)
      out=$(vault kv get -format=json -mount="$MOUNT" "$path") || exit 1
      jq '.data.data' <<< "$out" | "$HERE/secret-status" "$dir" --diff
      ;;
    *)
      log_error "Usage: vsecret files pull|push|diff <path> <dir>"
      exit 1
      ;;
  esac
}

# -----------------------------------------------------
# Main
# -----------------------------------------------------

require vault jq

case "$COMMAND" in
  ls) command_ls "$@";;
  get) command_get "$@";;
  set) command_set "$@";;
  unset) command_unset "$@";;
  edit) command_edit "$@";;
  files) command_files "$@";;
  ""|help) sed -n '2,/^$/p' "$THIS" | sed 's/^# \{0,1\}//';;
  *) log_error "Unknown command: $COMMAND (vsecret help)"; exit 1;;
esac
