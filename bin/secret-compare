#!/usr/bin/env python3
#
# Compares two secrets (flat JSON objects of strings) and prints the keys added, changed and
# removed going from OLD to NEW. Only key names, never values.
#
# Exit codes:
#   - 0 if they're the same
#   - 1 if there are changes
#   - 2 if NEW isn't a JSON object of strings
#
# Usage:
# secret-compare <OLD> <NEW>     (file paths, - for stdin)

import argparse
import json
import sys


def load(path: str) -> object:
    if path == "-":
        return json.load(sys.stdin)
    with open(path) as file:
        return json.load(file)


def is_secret(value: object) -> bool:
    return isinstance(value, dict) and all(isinstance(v, str) for v in value.values())


def compare(old: dict[str, str], new: dict[str, str]) -> list[str]:
    return (
        [f"  added:   {k}" for k in sorted(new.keys() - old.keys())]
        + [
            f"  changed: {k}"
            for k in sorted(new.keys() & old.keys())
            if new[k] != old[k]
        ]
        + [f"  removed: {k}" for k in sorted(old.keys() - new.keys())]
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Prints the keys that differ between two secrets."
    )
    parser.add_argument("old", help="The secret before (a file, - for stdin).")
    parser.add_argument("new", help="The secret after (a file, - for stdin).")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    old = load(args.old)
    try:
        new = load(args.new)
    except json.JSONDecodeError as error:
        print(f"Not JSON: {error}", file=sys.stderr)
        sys.exit(2)

    if not is_secret(new):
        print("Not a JSON object of string values.", file=sys.stderr)
        sys.exit(2)

    lines = compare(old, new)
    if lines:
        print("\n".join(lines))
    sys.exit(1 if lines else 0)


if __name__ == "__main__":
    main()
