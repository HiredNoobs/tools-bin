#!/usr/bin/env bash
#
# The `setup` in the root directory will use these functions on arch.
# It doesn't do anything when executed directly.

# Installs packages and marks them explicitly installed. --needed skips packages that are already
# here as another package's dependency, and those get removed by `pacman -Rns` or an orphan cleanup
# once nothing depends on them any more (this took out networkmanager, bluez and playerctl).
function pacman_install {
  sudo pacman -S --needed --noconfirm "$@" && sudo pacman -D --asexplicit --quiet "$@"
}

function configure_bash {
  pacman_install bash-completion
  rsync -av "$ROOT/dotfiles/.bashrc" ~/.bashrc
  rsync -av --delete "$ROOT/dotfiles/.config/bashrc/" "$XDG_CONFIG_HOME/bashrc/"
}

function configure_hyprland {
  local cursor_version

  log_info "Configuring hyprland."
  log_info "Installing dependencies."

  # Hyprland + utils (python-dbus and python-gobject are for the Bluetooth pairing agent)
  pacman_install hyprland hyprlock hypridle hyprshutdown hyprsunset hyprpolkitagent \
    sddm pipewire pipewire-audio pipewire-pulse wireplumber xdg-desktop-portal xdg-desktop-portal-hyprland \
    xdg-desktop-portal-gtk udiskie brightnessctl pamixer playerctl quickshell bluez libnotify wl-clipboard libqalculate pacman-contrib power-profiles-daemon \
    swaybg starship yazi kitty fish firefox grim slurp swappy htop btop nvtop \
    networkmanager unzip python-dbus python-gobject xdg-terminal-exec \
    qt5-wayland qt6-wayland qt5ct qt6ct kvantum-qt5 kvantum adw-gtk-theme papirus-icon-theme \
    otf-codenewroman-nerd

  log_info "Dependencies installed. Starting configuration."

  # Bluetooth will start in non-discoverable mode
  sudo sed -i -e 's/^\#AutoEnable=true/AutoEnable=false/' /etc/bluetooth/main.conf
  sudo systemctl enable bluetooth --now

  # Power profiles for the system panel
  sudo systemctl enable power-profiles-daemon --now

  # Not --now, starting it would take over the current TTY
  sudo systemctl enable sddm

  cursor_version=$(get_latest_release "catppuccin/cursors")
  curl -fsSL "https://github.com/catppuccin/cursors/releases/download/$cursor_version/catppuccin-latte-red-cursors.zip" \
    -o /tmp/catppuccin-latte-red-cursors.zip
  unzip -o /tmp/catppuccin-latte-red-cursors.zip -d "$HOME/.local/share/icons/"

  # Only the first time: after that, Settings › Default apps changes it
  rsync -av --ignore-existing "$ROOT/dotfiles/.config/mimeapps.list" "$HOME/.config/mimeapps.list"
  mkdir -p "$HOME/.local/share/applications"
  ln -sfn "$HOME/.config/mimeapps.list" "$HOME/.local/share/applications/mimeapps.list"

  # Terminal apps (vim, yazi) opened from other apps run in kitty
  rsync -av "$ROOT/dotfiles/.config/xdg-terminals.list" "$HOME/.config/xdg-terminals.list"

  rsync -av "$ROOT/dotfiles/.config/starship.toml"      "$HOME/.config/starship.toml"

  # Only the first time: after that, the wallpaper picker changes it
  rsync -av --ignore-existing "$ROOT/images/wallpapers/nord_scenary.png" "$HOME/.cache/current-wallpaper"
  rsync -av --delete "$ROOT/images/wallpapers/"         "$HOME/Pictures/wallpapers/"
  rsync -av --delete "$ROOT/images/profile-pictures/"   "$HOME/Pictures/profile-pictures/"
  mkdir -p "$HOME/Pictures/screenshots"  # Used by the screenshot keybinds and swappy

  rsync -av --delete "$ROOT/dotfiles/.config/wal/"      "$HOME/.cache/wal/"

  # The avatar on the lock and login screens
  [ -e "$HOME/.face" ] || ln -s Pictures/profile-pictures/alluka.jpg "$HOME/.face"

  # Login screen: an SDDM theme that looks like the lockscreen, being the same LockLayout.qml
  sudo rsync -av --delete "$ROOT/system/usr/share/sddm/themes/quickshell-lock/" /usr/share/sddm/themes/quickshell-lock/
  sudo cp "$ROOT/dotfiles/.config/quickshell/lock/LockLayout.qml" /usr/share/sddm/themes/quickshell-lock/
  sudo install -Dm644 "$ROOT/system/etc/sddm.conf.d/quickshell-lock.conf" /etc/sddm.conf.d/quickshell-lock.conf
  # Keeps the Wi-Fi network's name where the theme can read it
  sudo install -Dm755 "$ROOT/system/etc/NetworkManager/dispatcher.d/90-quickshell-lock" /etc/NetworkManager/dispatcher.d/90-quickshell-lock
  # What it shows of the user (wallpaper, colours, avatar), where the sddm user can read it
  sudo install -d -o "$USER" -m 755 /var/lib/quickshell-lock /var/lib/quickshell-lock/faces
  cp -L "$HOME/.cache/current-wallpaper" /var/lib/quickshell-lock/wallpaper
  cp -L "$HOME/.face" "/var/lib/quickshell-lock/faces/$USER"
  cp "$HOME/.cache/wal/colors.json" /var/lib/quickshell-lock/colors.json

  # monitors.lua is the layout saved from the bar, local to each machine
  rsync -av --delete --exclude 'monitors.lua' --exclude 'input.lua' --exclude 'hypridle.local.conf' --exclude 'appearance.lua' "$ROOT/dotfiles/.config/hypr/" "$XDG_CONFIG_HOME/hypr/"
  rsync -av --delete "$ROOT/dotfiles/.config/quickshell/" "$XDG_CONFIG_HOME/quickshell/"
  rsync -av --delete "$ROOT/dotfiles/.config/kitty/"    "$XDG_CONFIG_HOME/kitty/"
  rsync -av --delete "$ROOT/dotfiles/.config/swappy/"   "$XDG_CONFIG_HOME/swappy/"
  rsync -av --delete "$ROOT/dotfiles/.config/fish/"     "$XDG_CONFIG_HOME/fish/"
}

function configure_docker {
  log_info "Installing docker and docker compose v2 latest."
  pacman_install docker docker-compose

  log_info "Adding $USER to docker group"
  create_group docker
  add_user_to_group "$USER" docker

  log_info "Starting and enabling docker"
  sudo systemctl enable docker --now
}

function configure_vim {
  log_info "Installing vim."
  pacman_install vim

  mkdir -p ~/.vim/autoload ~/.vim/bundle

  log_info "Setting up vim addon manager (pathogen)."

  curl -LSso ~/.vim/autoload/pathogen.vim https://raw.githubusercontent.com/tpope/vim-pathogen/ac4dd9494fa9008754e49dff85bff1b5746c89b4/autoload/pathogen.vim

  log_info "Cloning vim addons."

  get_latest_git https://github.com/vim-airline/vim-airline.git ~/.vim/bundle/airline --commit 1586662296c9dc946083e17cb6a4ef0b3e7c0d68
  get_latest_git https://github.com/preservim/nerdtree.git ~/.vim/bundle/nerdtree --commit 690d061b591525890f1471c6675bcb5bdc8cdff9
  get_latest_git https://github.com/tpope/vim-fugitive.git ~/.vim/bundle/fugitive --commit 3b753cf8c6a4dcde6edee8827d464ba9b8c4a6f0
  get_latest_git https://github.com/mhinz/vim-signify.git ~/.vim/bundle/vim-signify --commit 3b5ae37eb2b77c3ae58d60dfdc3fc30258078663
  get_latest_git https://github.com/morhetz/gruvbox.git ~/.vim/bundle/gruvbox --commit 697c00291db857ca0af00ec154e5bd514a79191f

  log_info "Installing YouCompleteMe."

  if ! get_latest_git https://github.com/ycm-core/YouCompleteMe.git ~/.vim/bundle/YouCompleteMe --commit 6a52780a22dfd4ddafbe23c0d2c2a2107ceeb397; then
    git -C ~/.vim/bundle/YouCompleteMe submodule update --init --recursive
    python3 ~/.vim/bundle/YouCompleteMe/install.py
  fi

  log_info "Copying vim config file."
  rsync -av "$ROOT/dotfiles/.vimrc" ~/.vimrc
}

function configure_tmux {
  pacman_install tmux
  rsync -av --delete "$ROOT/dotfiles/.config/tmux/" "$XDG_CONFIG_HOME/tmux/"
}
