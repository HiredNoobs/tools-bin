#!/usr/bin/env bash
#
# The `setup` in the root directory will use these functions on debian.
# It doesn't do anything when executed directly.

# Starship (the prompt, bash and fish): a pinned release into tools-bin's bin, checked against
# the checksums below (from the release's .sha256 files). Bump the version and both together.
STARSHIP_VERSION="v1.26.0"
declare -A STARSHIP_SHA256=(
  [x86_64]="b7c232b0e8249d8e55a40beb79c5c43a7d370f3f9408bd215deb0170daeaadf3"
  [aarch64]="dc30189378d2f2e287384e8a692d3f95ad1df64cf0e8c36aa9201516028aed6b"
)

function install_starship {
  local arch archive tmp

  if starship --version 2> /dev/null | grep -q "^starship ${STARSHIP_VERSION#v}$"; then
    return 0
  fi

  arch=$(uname -m)
  if [[ -z "${STARSHIP_SHA256[$arch]:-}" ]]; then
    log_error "No starship checksum for $arch."
    return 1
  fi

  archive="starship-$arch-unknown-linux-musl.tar.gz"
  tmp=$(mktemp -d)
  log_info "Installing starship $STARSHIP_VERSION."
  curl -fsSL "https://github.com/starship/starship/releases/download/$STARSHIP_VERSION/$archive" -o "$tmp/$archive"
  if ! echo "${STARSHIP_SHA256[$arch]}  $tmp/$archive" | sha256sum --check --status; then
    log_error "Checksum mismatch for $archive."
    rm -rf "$tmp"
    return 1
  fi
  tar -xzf "$tmp/$archive" -C "$tmp" starship
  install -m 755 "$tmp/starship" "$ROOT/bin/starship"
  rm -rf "$tmp"
}

function configure_bash {
  sudo apt-get install -y bash-completion
  install_starship
  rsync -av "$ROOT/dotfiles/.bashrc" ~/.bashrc
  # 40-host is generated per host by context-setup
  rsync -av --delete --exclude "40-host" "$ROOT/dotfiles/.config/bashrc/" "$XDG_CONFIG_HOME/bashrc/"
  rsync -av "$ROOT/dotfiles/.config/starship.toml" "$XDG_CONFIG_HOME/starship.toml"
}

function configure_fish {
  sudo apt-get install -y fish
  install_starship
  # conf.d/40-host.fish is generated per host by context-setup
  rsync -av --delete --exclude "conf.d/40-host.fish" "$ROOT/dotfiles/.config/fish/" "$XDG_CONFIG_HOME/fish/"
  rsync -av "$ROOT/dotfiles/.config/starship.toml" "$XDG_CONFIG_HOME/starship.toml"
}

function configure_docker {
  local docker_version docker_compose_version
  docker_version=$(get_latest_release "moby/moby")
  docker_compose_version=$(get_latest_release "docker/compose")

  log_info "Installing Docker $docker_version."
  curl -fsSL https://get.docker.com | sudo sh
  log_info "Installed Docker $docker_version"

  log_info "Installing Docker Compose $docker_compose_version"
  sudo mkdir -p /usr/local/lib/docker/cli-plugins
  sudo curl -fsSL "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-$(uname -s)-$(uname -m)" \
    -o /usr/local/lib/docker/cli-plugins/docker-compose
  sudo chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
  log_info "Installed Docker Compose $docker_compose_version"

  log_info "Adding $USER to docker group"
  create_group docker
  add_user_to_group "$USER" docker
  log_info "User added to docker group, relog or use 'exec sudo su -l \$USER' to access docker"

  log_info "Starting and enabling docker"
  sudo systemctl enable docker --now
}

function configure_vim {
  log_info "Installing vim."
  sudo apt-get install -y vim

  mkdir -p ~/.vim/autoload ~/.vim/bundle

  log_info "Setting up vim addon manager (pathogen)."

  curl -LSso ~/.vim/autoload/pathogen.vim https://raw.githubusercontent.com/tpope/vim-pathogen/ac4dd9494fa9008754e49dff85bff1b5746c89b4/autoload/pathogen.vim

  log_info "Cloning vim addons."

  sync_git https://github.com/vim-airline/vim-airline.git ~/.vim/bundle/airline --commit 1586662296c9dc946083e17cb6a4ef0b3e7c0d68
  sync_git https://github.com/preservim/nerdtree.git ~/.vim/bundle/nerdtree --commit 690d061b591525890f1471c6675bcb5bdc8cdff9
  sync_git https://github.com/tpope/vim-fugitive.git ~/.vim/bundle/fugitive --commit 3b753cf8c6a4dcde6edee8827d464ba9b8c4a6f0
  sync_git https://github.com/mhinz/vim-signify.git ~/.vim/bundle/vim-signify --commit 3b5ae37eb2b77c3ae58d60dfdc3fc30258078663
  sync_git https://github.com/morhetz/gruvbox.git ~/.vim/bundle/gruvbox --commit 697c00291db857ca0af00ec154e5bd514a79191f

  rsync -av "$ROOT/dotfiles/.vimrc" ~/.vimrc
}

function configure_tmux {
  sudo apt-get install -y tmux
  rsync -av --delete "$ROOT/dotfiles/.config/tmux/" "$XDG_CONFIG_HOME/tmux/"
}
