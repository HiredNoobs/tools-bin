#!/usr/bin/env python3
#
# Reads a secret (a flat JSON object of strings) from stdin, applies the changes given as
# arguments and prints the result as JSON. Keys that aren't mentioned are kept.
#
#   KEY=VALUE      Sets KEY to VALUE.
#   KEY=@FILE      Sets KEY to FILE's contents, exactly.
#   KEY            With --generate N, sets KEY to N random letters and digits.
#   --unset KEY    Removes KEY (an error if it doesn't exist).
#
# Usage:
# JSON | secret-merge [--generate N] [--unset KEY ...] [KEY[=VALUE|=@FILE] ...]


import argparse
import json
import re
import secrets
import string
import sys
from pathlib import Path

KEY_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+$")


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def generate(length: int) -> str:
    return "".join(
        secrets.choice(string.ascii_letters + string.digits) for _ in range(length)
    )


def merge(
    secret: dict[str, str], changes: list[str], unset: list[str], length: int | None
) -> dict[str, str]:
    result = dict(secret)

    for key in unset:
        if key not in result:
            fail(f"No key {key} to unset.")
        del result[key]

    for change in changes:
        key, has_value, value = change.partition("=")
        if not KEY_PATTERN.match(key):
            fail(f"'{key}' isn't a key name (letters, digits, _ . -).")
        if has_value and value.startswith("@"):
            value = Path(value[1:]).read_text()
        elif not has_value:
            if not length:
                fail(f"{key} needs a value: {key}=VALUE, {key}=@FILE or --generate N.")
            value = generate(length)
        result[key] = value

    return result


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Applies changes to the secret (a flat JSON object of strings) on stdin."
    )
    parser.add_argument(
        "changes", nargs="*", metavar="KEY[=VALUE|=@FILE]", help="Keys to set."
    )
    parser.add_argument(
        "--unset", action="append", default=[], metavar="KEY", help="A key to remove."
    )
    parser.add_argument(
        "--generate",
        type=int,
        metavar="N",
        help="Generate N letters and digits for keys without a value.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    secret = json.load(sys.stdin)
    if not isinstance(secret, dict):
        fail("The secret on stdin isn't a JSON object.")
    json.dump(merge(secret, args.changes, args.unset, args.generate), sys.stdout)


if __name__ == "__main__":
    main()
