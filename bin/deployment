#!/usr/bin/env bash

THIS=$(realpath "$0")
HERE=$(dirname "$THIS")

source "$HERE/lib/logging.sh"
source "$HERE/lib/utils.sh"
source "$HERE/lib/confirmation.sh"

# -----------------------------------------------------
# Helper functions
# -----------------------------------------------------

function check_env {
  local contexts current_stack

  if [[ ! -v DEPLOYMENT ]]; then
    log_error "DEPLOYMENT is unset - source a stack.env file"
    exit 1
  fi

  contexts=$(docker context ls --format '{{ .Name }}' | grep -v 'default')
  if ! printf '%s\n' "$contexts" | grep -Fxq -- "$CONTEXT"; then
    log_error "Context, $CONTEXT, not in locally defined contexts."
    exit 1
  fi

  current_stack=$(basename "$PWD")
  if [ "stack-$STACK_BASE" != "$current_stack" ]; then
    log_error "Sourced stack ($STACK_BASE) doesn't match the current stack."
    exit 1
  fi

  if ! env_matches_file "$ENVIRONMENT_BASE/stack.env"; then
    log_warning "Current env doesn't match the stack.env"
  fi
}

# Compare the values in $1 (generally the stack.env) to the
# current environment. If any differences are found return 1
# else return 0.
function env_matches_file {
  local file evaluated_env exported_vars key expected
  file="$1"

  evaluated_env=$(bash -c "set -a; source \"$file\" >/dev/null 2>&1; env")
  exported_vars=$(grep -E '^[[:space:]]*export[[:space:]]+' "$file" \
                  | sed -E 's/^[[:space:]]*export[[:space:]]+//' \
                  | sed -E 's/[[:space:]]*#.*//' \
                  | cut -d= -f1 \
                  | xargs)

  for key in $exported_vars; do
    expected=$(echo "$evaluated_env" | grep -E "^${key}=" | cut -d= -f2-)
    if [[ -z "${!key+x}" || "${!key}" != "$expected" ]]; then
      return 1
    fi
  done

  return 0
}

function discover_stack_context {
  export DOCKER_CONTEXT="$CONTEXT"

  if [ -f "${SECRETS}/secrets.env" ]; then
    source "${SECRETS}/secrets.env"
  fi

  if [[ -v DOMAIN ]]; then
    eval "$(docker node ls -q | xargs docker node inspect | export-roles "$STACK" --domain "$DOMAIN")"
  else
    eval "$(docker node ls -q | xargs docker node inspect | export-roles "$STACK")"
  fi

  stack_discover
}

# -----------------------------------------------------
# Run functions
# -----------------------------------------------------

function run_help {
  local deployment_commands term_width help_func help_output combined_output

  if [ -f "$HERE/deployment_help" ]; then
    source "$HERE/deployment_help"
  fi

  if [ -f "$STACK_BASE/stack_help" ]; then
    source "$STACK_BASE/stack_help"
  fi

  deployment_commands=$(declare -F | awk '/ command_/ && (!/_help$/ || /command_help$/) { gsub("command_", "", $3); print $3 }')

  echo "Deployment commands:"
  term_width=$(tput cols)

  for func in $deployment_commands; do
    echo "* $func"
    help_func="command_${func}_help"
    if declare -F "$help_func" > /dev/null; then
      help_output=$("$help_func")
      combined_output=$(echo "$help_output" | awk 'BEGIN { ORS=" " } { if (NF == 0) { print "\n" } else { print } }' | sed 's/$ //' | fold -s -w "$term_width")
      echo "$combined_output" | sed 's/^/    /'
    fi
  done
}

function run_secret_pull {
  local vault_env="$1"
  local vault_secret="$2"
  local local_secrets_dir="$3"

  mkdir -p "$local_secrets_dir"
  if [ "${VAULT_KV_VERSION:-}" = "2" ]; then
    if out=$(vault kv get -format=json -mount labv2 "$vault_env/$vault_secret"); then
      echo "$out" | jq '.data.data' | secret-unpack "$local_secrets_dir"
      echo "$out" | jq '.data.metadata' > "$local_secrets_dir/.metadata.json"
    fi
  else
    if out=$(vault read "lab/$vault_env/$vault_secret" -format=json); then
      echo "$out" | jq '.data' | secret-unpack "$local_secrets_dir"
    fi
  fi
}

function run_secret_push {
  local vault_env="$1"
  local vault_secret="$2"
  local local_secrets_dir="$3"

  # Check for at least one non-hidden file
  if compgen -G "$local_secrets_dir"/* > /dev/null; then
    if [ "${VAULT_KV_VERSION:-}" = "2" ]; then
      local cas
      if [ -f "$local_secrets_dir/.metadata.json" ]; then
        cas=$(jq -r '.version' "$local_secrets_dir/.metadata.json")
      else
        cas="0"
      fi

      if secret-pack "$local_secrets_dir"/* | vault kv put -cas="$cas" -mount labv2 "$vault_env/$vault_secret" -; then
        # Refresh metadata after a successful write
        vault kv get -format=json -mount labv2 "$vault_env/$vault_secret" \
          | jq '.data.metadata' > "$local_secrets_dir/.metadata.json"
      fi
    else
      secret-pack "$local_secrets_dir"/* | vault write "lab/$vault_env/$vault_secret" -
    fi
  else
    echo "There are no local secrets to push."
    echo "If you intended to delete the $vault_secret secret please use the UI."
  fi
}

function run_secret_status {
  local vault_env="$1"
  local vault_secret="$2"
  local local_secrets_dir="$3"
  local diff=""

  if [[ "${4:-}" == "--diff" ]]; then
    diff="--diff"
  fi

  if [ "${VAULT_KV_VERSION:-}" = "2" ]; then
    if out=$(vault kv get -format=json -mount labv2 "$vault_env/$vault_secret"); then
      echo "$out" | jq '.data.data' | secret-status "$local_secrets_dir" $diff
      return $?
    else
      return 1
    fi
  else
    if out=$(vault read "lab/${vault_env}/${vault_secret}" -format=json); then
      echo "$out" | jq '.data' | secret-status "$local_secrets_dir" $diff
      return $?
    else
      return 1
    fi
  fi
}

function run_tools {
  stack_tools $@
}

function run_env {
  echo "DEPLOYMENT  = $DEPLOYMENT"
  echo "STACK       = $STACK"
  echo "ENVIRONMENT = $ENVIRONMENT"
  echo "CONTEXT     = $CONTEXT"
  echo "CONFIGS     = $CONFIGS"
  echo "SECRETS     = $SECRETS"
  stack_env
}

function run_deploy {
  if [[ -f "$SECRETS/external.yml" ]]; then
    local external_secret_env external_secret external_key

    for external_secret_env in $(yq -r '.external | keys | .[]' "$SECRETS/external.yml"); do
      for external_secret in $(yq -r ".external.$external_secret_env | keys | .[]" "$SECRETS/external.yml"); do
        mkdir -p "$SECRETS/$external_secret"
        run_secret_pull "$external_secret_env" "$external_secret" "$SECRETS/$external_secret"

        for external_key in $(yq -r ".external.$external_secret_env.${external_secret}[]" "$SECRETS/external.yml"); do
          if [[ -f "$SECRETS/$external_secret/$external_key" ]]; then
            docker secret create "external_${STACK}.${external_secret}_${external_key//./_}" "$SECRETS/$external_secret/$external_key" > /dev/null
          fi
        done

        # $SECRETS is almostly certainly set but let's not accidentally run "rm -rf /"
        rm -rf "${SECRETS:?}/$external_secret"
      done
    done
  fi

  stack_deploy
}

function run_status {
  docker stack ps "$STACK"
}

function run_clean {
  local swarm_secrets swarm_secret

  log_info "Removing $STACK."
  docker stack rm "$STACK" --detach=false

  log_info "Removing $STACK external secrets."
  swarm_secrets=$(docker secret ls --format '{{ .ID }} {{ .Name }}' | grep "external_$STACK" | awk '{print $1}')
  for swarm_secret in $swarm_secrets; do
    docker secret rm "$swarm_secret" > /dev/null
  done
}

function run_purge {
  log_warning "Purging volumes for $STACK in $ENVIRONMENT."
  
  local nodes

  # This will potentially run against the same nodes multiple times
  # for stacks with mulitple containers on the same nodes.
  # Is this worth addressing?
  for var in $(compgen -e | grep '_FQDN_NODES$'); do
    nodes="${!var}"

    for host in $nodes; do
      log_warning "Checking $host for volumes..."
      vols=$(docker -H "ssh://$host" volume ls -q --filter "name=${STACK}_.*_data")
      
      if [[ -n "$vols" ]]; then
        log_warning "Deleting:"
        docker -H "ssh://$host" volume rm $vols
      fi
    done
  done
}

# -----------------------------------------------------
# Commands
# -----------------------------------------------------

function command_help {
  run_help
}

function command_tools {
  if [ ! -d "$STACK_PATH/tools" ]; then
    log_error "No tools for current stack."
    exit 1
  fi

  discover_stack_context
  run_tools $@
}

function command_secret_pull {
  local env="${1:-$ENVIRONMENT}"
  local secret="${2:-$STACK}"
  local secrets_dir="${3:-$SECRETS}"

  run_secret_pull "$env" "$secret" "$secrets_dir"
}

function command_secret_push {
  local env="${1:-$ENVIRONMENT}"
  local secret="${2:-$STACK}"
  local secrets_dir="${3:-$SECRETS}"

  if run_secret_status "$env" "$secret" >/dev/null 2>&1; then
    echo "Local secrets are identical to upstream. Skipping push."
    return 0
  fi

  run_secret_push "$env" "$secret" "$secrets_dir"
}

function command_secret_status {
  local env="${1:-$ENVIRONMENT}"
  local secret="${2:-$STACK}"
  local secrets_dir="${3:-$SECRETS}"

  run_secret_status "$env" "$secret" "$secrets_dir"
}

function command_secret_diff {
  local env="${1:-$ENVIRONMENT}"
  local secret="${2:-$STACK}"
  local secrets_dir="${3:-$SECRETS}"

  run_secret_status "$env" "$secret" "$secrets_dir" --diff
}

function command_env {
  discover_stack_context
  if [ -z "$1" ]; then
    run_env
  else
    $@
    exit $?
  fi
}

function command_deploy {
  discover_stack_context
  run_deploy
}

function command_status {
  discover_stack_context
  run_status
}

function command_clean {
  discover_stack_context
  run_clean
}

function command_purge {
  discover_stack_context

  confirm_dangerous || exit 0

  run_clean
  log_info "Waiting for volumes to detach..."
  sleep 10
  run_purge
}

# -----------------------------------------------------
# Main
# -----------------------------------------------------

check_env
source "./stack"
stack_check_env

ARG=${1:-help}
CMD="command_$ARG"
shift

if declare -F "$CMD" >/dev/null; then
  $CMD "$@"
else
  log_error "$ARG is not a valid command."
fi
