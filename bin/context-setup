#!/usr/bin/env bash
#
# Installs the pinned vault, talosctl, kubectl and flux (each only when its version differs), then
# configures the kube and Talos contexts for the Talos clusters this host manages (one per
# talosconfig in ~/.talos/contexts) and records the default in ~/.config/bashrc/40-host (and
# fish/conf.d/40-host.fish). Any existing kube contexts are replaced.
#
# Usage:
# context-setup [--tools]
#   --tools  only install the pinned tools, the contexts are left as they are

THIS=$(realpath "$0")
HERE=$(dirname "$THIS")

source $HERE/lib/logging.sh

HOST_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/bashrc/40-host"
FISH_HOST_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/40-host.fish"
KUBE_CONTEXTS="$HOME/.kube/contexts"

# K8S clusters run Talos, kubeconfigs are generated with talosctl using
# the cluster's talosconfig (from `talosctl gen config`), one per context.
TALOS_CONTEXTS="$HOME/.talos/contexts"

# Keep in line with talos_version/kubernetes_version in iac-homelab/terraform/clusters,
# kubectl supports one minor version either side of the cluster.
TALOSCTL_VERSION="v1.14.4"
KUBECTL_VERSION="v1.37.1"

# The version `flux bootstrap` installs in the clusters (iac-k8s), bump it deliberately and
# re-run the bootstrap to upgrade them.
FLUX_VERSION="v2.9.6"

# The Vault client, for vsecret. Keep in line with vault_version in iac-homelab's vault role.
VAULT_VERSION="2.2.1"

# K8S contexts are the talosconfigs in $TALOS_CONTEXTS (<context>.yaml), which already have the
# control plane IPs, so they don't need DNS.
K8S_DEFAULT_CONTEXT="production.core"

# -----------------------------------------------------
# Functions
# -----------------------------------------------------
# Writes the `export NAME="value"` lines on stdin to the bash host config, and the same as
# `set -gx NAME "value"` to fish's (sourced before config.fish).
function write_host_config {
  local exports header
  exports=$(cat)
  header=$'# -----------------------------------------------------\n# HOST - generated by context-setup\n# -----------------------------------------------------\n'

  mkdir -p "$(dirname "$HOST_CONFIG")" "$(dirname "$FISH_HOST_CONFIG")"
  printf '%s\n%s\n' "$header" "$exports" > "$HOST_CONFIG"
  printf '%s\n%s\n' "$header" "$(sed -E 's/^export ([A-Za-z_][A-Za-z0-9_]*)=/set -gx \1 /' <<< "$exports")" > "$FISH_HOST_CONFIG"

  log_info "Wrote $HOST_CONFIG and $FISH_HOST_CONFIG - open a new shell (or source them)."
}

# -----------------------------------------------------
# K8S
# -----------------------------------------------------

function clean_k8s_contexts {
  local config

  for config in "$KUBE_CONTEXTS"/*.yaml; do
    [[ -f "$config" ]] || continue
    log_info "Deleting kube context: $(basename "$config" .yaml)"
    rm -f "$config"
  done
}

# Generates an admin kubeconfig from the Talos control plane into its own file, renaming
# the cluster/user/context to the context name so they never clash between clusters.
# The admin client cert expires (1 year by default), re-run context-setup to renew it.
function create_k8s_context {
  local context_name talosconfig control_plane generated config
  context_name="$1"
  talosconfig="$TALOS_CONTEXTS/$context_name.yaml"
  config="$KUBE_CONTEXTS/$context_name.yaml"

  # The talosconfig's nodes are every node in the cluster, kubeconfig needs a single
  # control plane so use the first endpoint.
  control_plane=$(talosctl --talosconfig "$talosconfig" config info -o json | jq -r '.endpoints[0] // empty')
  if [[ -z "$control_plane" ]]; then
    log_error "No endpoints in $talosconfig."
    return 1
  fi

  generated=$(mktemp)
  if ! talosctl --talosconfig "$talosconfig" --nodes "$control_plane" \
         kubeconfig "$generated" --force --merge=false; then
    log_error "Failed to generate a kubeconfig from $control_plane."
    rm -f "$generated"
    return 1
  fi

  (
    umask 077
    kubectl --kubeconfig "$generated" config view --raw --minify --flatten -o json \
      | jq --arg name "$context_name" '
          .clusters[0].name = $name
          | .users[0].name = $name
          | .contexts[0].name = $name
          | .contexts[0].context.cluster = $name
          | .contexts[0].context.user = $name
          | ."current-context" = $name
          | if .contexts[0].context.namespace == "default" then del(.contexts[0].context.namespace) else . end' > "$config"
  )

  rm -f "$generated"
  echo "$context_name"
}

function configure_k8s {
  local talosconfig default_context

  if ! command -v jq > /dev/null; then
    log_error "jq is required for k8s contexts."
    exit 1
  fi

  clean_k8s_contexts
  mkdir -p "$KUBE_CONTEXTS"

  echo
  log_info "Creating kube contexts:"
  for talosconfig in "$TALOS_CONTEXTS"/*.yaml; do
    [[ -f "$talosconfig" ]] || continue
    create_k8s_context "$(basename "$talosconfig" .yaml)"
  done

  # Fall back to any context if the default cluster doesn't exist.
  default_context="$K8S_DEFAULT_CONTEXT"
  if [[ ! -f "$KUBE_CONTEXTS/$default_context.yaml" ]]; then
    default_context=$(find "$KUBE_CONTEXTS" -name '*.yaml' -printf '%f\n' 2> /dev/null | sort | head -n 1)
    default_context="${default_context%.yaml}"
  fi

  if [[ -z "$default_context" ]]; then
    log_error "No kube contexts were created, are there talosconfigs in $TALOS_CONTEXTS?"
    exit 1
  fi

  write_host_config <<EOF
export KUBE_CONTEXTS="$KUBE_CONTEXTS"
export KUBECONFIG="$KUBE_CONTEXTS/$default_context.yaml"
export TALOS_CONTEXTS="$TALOS_CONTEXTS"
export TALOSCONFIG="$TALOS_CONTEXTS/$default_context.yaml"
EOF
}

# -----------------------------------------------------
# Tools
# -----------------------------------------------------

function linux_arch {
  case "$(uname -m)" in
    x86_64)        echo "amd64";;
    aarch64|arm64) echo "arm64";;
    *) log_error "Unsupported architecture: $(uname -m)"; exit 1;;
  esac
}

# Downloads $1 and, if its checksum matches $3, installs it as $HERE/$2: the download itself, or
# the file $2 in it when it's a .tar.gz or .zip.
function install_binary {
  local url name checksum tmp
  url="$1"
  name="$2"
  checksum="$3"
  tmp=$(mktemp -d)

  log_info "Installing $name from $url"
  if ! curl -fsSL "$url" -o "$tmp/download"; then
    log_error "Failed to download $name."
    rm -rf "$tmp"
    exit 1
  fi

  if ! echo "$checksum  $tmp/download" | sha256sum --check --status; then
    log_error "Checksum mismatch for $name."
    rm -rf "$tmp"
    exit 1
  fi

  case "$url" in
    *.tar.gz) tar -xzf "$tmp/download" -C "$tmp" "$name";;
    *.zip)    unzip -q "$tmp/download" "$name" -d "$tmp";;
    *)        mv "$tmp/download" "$tmp/$name";;
  esac
  install -m 755 "$tmp/$name" "$HERE/$name"
  rm -rf "$tmp"
}

function install_talosctl {
  local arch checksum
  arch=$(linux_arch)

  if talosctl version --client --short 2>/dev/null | grep -q "Talos $TALOSCTL_VERSION$"; then
    return 0
  fi

  checksum=$(curl -fsSL "https://github.com/siderolabs/talos/releases/download/$TALOSCTL_VERSION/sha256sum.txt" \
             | awk -v file="talosctl-linux-$arch" '$2 == file { print $1 }')

  install_binary "https://github.com/siderolabs/talos/releases/download/$TALOSCTL_VERSION/talosctl-linux-$arch" \
    talosctl "$checksum"
}

function install_kubectl {
  local arch checksum
  arch=$(linux_arch)

  if kubectl version --client 2>/dev/null | grep -q "Client Version: $KUBECTL_VERSION$"; then
    return 0
  fi

  checksum=$(curl -fsSL "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/$arch/kubectl.sha256")

  install_binary "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/$arch/kubectl" \
    kubectl "$checksum"
}

function install_flux {
  local arch version archive url checksum
  arch=$(linux_arch)
  version="${FLUX_VERSION#v}"
  archive="flux_${version}_linux_$arch.tar.gz"
  url="https://github.com/fluxcd/flux2/releases/download/$FLUX_VERSION"

  if flux version --client 2>/dev/null | grep -q "flux: $FLUX_VERSION$"; then
    return 0
  fi

  checksum=$(curl -fsSL "$url/flux_${version}_checksums.txt" \
             | awk -v file="$archive" '$2 == file { print $1 }')

  install_binary "$url/$archive" flux "$checksum"
}

function install_vault {
  local arch archive url checksum
  arch=$(linux_arch)
  archive="vault_${VAULT_VERSION}_linux_$arch.zip"
  url="https://releases.hashicorp.com/vault/$VAULT_VERSION"

  if vault version 2>/dev/null | grep -q "^Vault v$VAULT_VERSION "; then
    return 0
  fi

  checksum=$(curl -fsSL "$url/vault_${VAULT_VERSION}_SHA256SUMS" \
             | awk -v file="$archive" '$2 == file { print $1 }')

  install_binary "$url/$archive" vault "$checksum"
}

function install_tools {
  install_vault
  install_talosctl
  install_kubectl
  install_flux
}

# -----------------------------------------------------
# Main
# -----------------------------------------------------

if [[ $# -gt 1 || ( $# -eq 1 && "$1" != "--tools" ) ]]; then
  log_error "Usage: $(basename "$0") [--tools]"
  exit 1
fi

install_tools
[[ "${1:-}" == "--tools" ]] || configure_k8s
