#!/usr/bin/env bash
#
# Configures the contexts for the orchestrator this host manages and
# records the orchestrator in ~/.config/bashrc/40-host for `deployment`.
# A host only manages one orchestrator, any existing contexts are removed.
#
# Usage:
# context-setup <swarm|k8s>

THIS=$(realpath "$0")
HERE=$(dirname "$THIS")

source $HERE/lib/logging.sh

HOST_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/bashrc/40-host"
KUBE_CONTEXTS="$HOME/.kube/contexts"

# K8S clusters run Talos, kubeconfigs are generated with talosctl using
# the cluster's talosconfig (from `talosctl gen config`), one per context.
TALOS_CONTEXTS="$HOME/.talos/contexts"

# Keep in line with talos_version/kubernetes_version in iac-homelab/talos,
# kubectl supports one minor version either side of the cluster.
TALOSCTL_VERSION="v1.14.1"
KUBECTL_VERSION="v1.37.0"

# -----------------------------------------------------
# Contexts
# -----------------------------------------------------
# Context name -> swarm manager host
#
# K8S contexts are the talosconfigs in $TALOS_CONTEXTS (<context>.yaml), which
# already have the control plane IPs, so they don't need DNS.

declare -A SWARM_CONTEXTS=(
  [development.core]="atlas"
  [production.edge]="prod-nginx001"
  [production.core]="prod-rsyslog001"
  [production.services]="prod-vault001"
)
SWARM_DEFAULT_CONTEXT="development.core"

K8S_DEFAULT_CONTEXT="production.core"

# -----------------------------------------------------
# Functions
# -----------------------------------------------------
function usage {
  echo "Usage: $(basename "$0") <swarm|k8s>"
}

function is_local_host {
  [[ "$1" == "${HOSTNAME}.${DOMAIN}" ]]
}

function write_host_config {
  mkdir -p "$(dirname "$HOST_CONFIG")"
  {
    echo "# -----------------------------------------------------"
    echo "# HOST - generated by context-setup"
    echo "# -----------------------------------------------------"
    echo
    cat
  } > "$HOST_CONFIG"

  log_info "Wrote $HOST_CONFIG - run 'source ~/.bashrc' or open a new shell."
}

# -----------------------------------------------------"
# Swarm
# -----------------------------------------------------"

function clean_docker_contexts {
  local contexts context

  command -v docker > /dev/null || return 0
  contexts=$(docker context ls --format '{{ .Name }}' | grep -v 'default')

  [[ -z "$contexts" ]] && return 0

  log_info "Deleting docker contexts:"
  for context in $contexts; do
    docker context rm -f "$context"
  done
}

function create_docker_context {
  local context_name context_hostname
  context_name="$1"
  context_hostname="$2"
  if is_local_host "$context_hostname"; then
    docker context create --from "default" --description "local" $context_name 2> /dev/null
  else
    docker context create --docker "host=ssh://${context_hostname}" $context_name 2> /dev/null
  fi
}

function configure_swarm {
  local context default_context

  clean_k8s_contexts
  clean_docker_contexts

  echo
  log_info "Creating docker contexts:"
  for context in "${!SWARM_CONTEXTS[@]}"; do
    create_docker_context "$context" "${SWARM_CONTEXTS[$context]}.${DOMAIN}"
  done

  default_context="default"
  if docker context inspect "$SWARM_DEFAULT_CONTEXT" > /dev/null 2>&1; then
    default_context="$SWARM_DEFAULT_CONTEXT"
  fi

  write_host_config <<EOF
export ORCHESTRATOR="swarm"
export DOCKER_CONTEXT="$default_context"
EOF
}

# -----------------------------------------------------"
# K8S 
# -----------------------------------------------------"

function clean_k8s_contexts {
  local config

  for config in "$KUBE_CONTEXTS"/*.yaml; do
    [[ -f "$config" ]] || continue
    log_info "Deleting kube context: $(basename "$config" .yaml)"
    rm -f "$config"
  done
}

# Generates an admin kubeconfig from the Talos control plane into its own file, renaming
# the cluster/user/context to the context name so they never clash between clusters.
# The admin client cert expires (1 year by default), re-run context-setup to renew it.
function create_k8s_context {
  local context_name talosconfig control_plane generated config
  context_name="$1"
  talosconfig="$TALOS_CONTEXTS/$context_name.yaml"
  config="$KUBE_CONTEXTS/$context_name.yaml"

  # The talosconfig's nodes are every node in the cluster, kubeconfig needs a single
  # control plane so use the first endpoint.
  control_plane=$(talosctl --talosconfig "$talosconfig" config info -o json | jq -r '.endpoints[0] // empty')
  if [[ -z "$control_plane" ]]; then
    log_error "No endpoints in $talosconfig."
    return 1
  fi

  generated=$(mktemp)
  if ! talosctl --talosconfig "$talosconfig" --nodes "$control_plane" \
         kubeconfig "$generated" --force --merge=false; then
    log_error "Failed to generate a kubeconfig from $control_plane."
    rm -f "$generated"
    return 1
  fi

  (
    umask 077
    kubectl --kubeconfig "$generated" config view --raw --minify --flatten -o json \
      | jq --arg name "$context_name" '
          .clusters[0].name = $name
          | .users[0].name = $name
          | .contexts[0].name = $name
          | .contexts[0].context.cluster = $name
          | .contexts[0].context.user = $name
          | ."current-context" = $name' > "$config"
  )

  rm -f "$generated"
  echo "$context_name"
}

function linux_arch {
  case "$(uname -m)" in
    x86_64)        echo "amd64";;
    aarch64|arm64) echo "arm64";;
    *) log_error "Unsupported architecture: $(uname -m)"; exit 1;;
  esac
}

# Downloads $1 to $HERE/$2 if the checksum matches $3.
function install_binary {
  local url name checksum tmp
  url="$1"
  name="$2"
  checksum="$3"
  tmp=$(mktemp)

  log_info "Installing $name from $url"
  if ! curl -fsSL "$url" -o "$tmp"; then
    log_error "Failed to download $name."
    rm -f "$tmp"
    exit 1
  fi

  if ! echo "$checksum  $tmp" | sha256sum --check --status; then
    log_error "Checksum mismatch for $name."
    rm -f "$tmp"
    exit 1
  fi

  install -m 755 "$tmp" "$HERE/$name"
  rm -f "$tmp"
}

function install_talosctl {
  local arch checksum
  arch=$(linux_arch)

  if talosctl version --client --short 2>/dev/null | grep -q "Talos $TALOSCTL_VERSION$"; then
    return 0
  fi

  checksum=$(curl -fsSL "https://github.com/siderolabs/talos/releases/download/$TALOSCTL_VERSION/sha256sum.txt" \
             | awk -v file="talosctl-linux-$arch" '$2 == file { print $1 }')

  install_binary "https://github.com/siderolabs/talos/releases/download/$TALOSCTL_VERSION/talosctl-linux-$arch" \
    talosctl "$checksum"
}

function install_kubectl {
  local arch checksum
  arch=$(linux_arch)

  if kubectl version --client 2>/dev/null | grep -q "Client Version: $KUBECTL_VERSION$"; then
    return 0
  fi

  checksum=$(curl -fsSL "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/$arch/kubectl.sha256")

  install_binary "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/$arch/kubectl" \
    kubectl "$checksum"
}

function configure_k8s {
  local talosconfig default_context

  install_talosctl
  install_kubectl

  if ! command -v jq > /dev/null; then
    log_error "jq is required for k8s contexts."
    exit 1
  fi

  clean_docker_contexts
  clean_k8s_contexts
  mkdir -p "$KUBE_CONTEXTS"

  echo
  log_info "Creating kube contexts:"
  for talosconfig in "$TALOS_CONTEXTS"/*.yaml; do
    [[ -f "$talosconfig" ]] || continue
    create_k8s_context "$(basename "$talosconfig" .yaml)"
  done

  # Fall back to any context if the default cluster doesn't exist.
  default_context="$K8S_DEFAULT_CONTEXT"
  if [[ ! -f "$KUBE_CONTEXTS/$default_context.yaml" ]]; then
    default_context=$(find "$KUBE_CONTEXTS" -name '*.yaml' -printf '%f\n' 2> /dev/null | sort | head -n 1)
    default_context="${default_context%.yaml}"
  fi

  if [[ -z "$default_context" ]]; then
    log_error "No kube contexts were created, are there talosconfigs in $TALOS_CONTEXTS?"
    exit 1
  fi

  write_host_config <<EOF
export ORCHESTRATOR="k8s"
export KUBE_CONTEXTS="$KUBE_CONTEXTS"
export KUBECONFIG="$KUBE_CONTEXTS/$default_context.yaml"
export TALOS_CONTEXTS="$TALOS_CONTEXTS"
export TALOSCONFIG="$TALOS_CONTEXTS/$default_context.yaml"
EOF
}

# -----------------------------------------------------"
# Common
# -----------------------------------------------------"

function install_vault_client {
  curl https://releases.hashicorp.com/vault/1.21.0/vault_1.21.0_linux_386.zip -o /tmp/vault.zip
  unzip -o /tmp/vault.zip -d /tmp/vault
  mv /tmp/vault/vault ~/tools-bin/bin/vault
  chmod +x ~/tools-bin/bin/vault
}

# -----------------------------------------------------
# Main
# -----------------------------------------------------

ORCHESTRATOR="$1"

case "$ORCHESTRATOR" in
  swarm|k8s) ;;
  *) usage; exit 1;;
esac

if [[ ! -v DOMAIN ]]; then
  log_error "DOMAIN is unset - run 'setup bash' first."
  exit 1
fi

install_vault_client
configure_"$ORCHESTRATOR"
